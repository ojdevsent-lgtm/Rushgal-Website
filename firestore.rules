rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admin_user/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_user/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/admin_user/$(request.auth.uid)).data.role == 'admin';
    }
    function validOrder() {
      return request.resource.data.keys().hasAll(['customer','items','total','fulfilment','paymentMethod','status','createdAt'])
        && request.resource.data.paymentMethod == 'pay_on_delivery'
        && request.resource.data.status == 'new'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.fulfilment in ['delivery','pickup'];
    }

    match /admin_user/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /deliveryZones/{zoneId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if validOrder();
      allow read, update, delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    match /siteContent/{contentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
